# Caddy for the personal install. It listens on plain HTTP inside the stack: TLS ends at Cloudflare,
# and cloudflared reaches it over the private network. This file sets the client's address; the
# routes, the same for every way of serving, are in routes.caddy.
{
	auto_https off
	admin off
}

:80 {
	# The client's address, which routes.caddy logs and sends to the API and the MCP as the only
	# X-Forwarded-For entry (the API trusts just this hop). Each line has a matcher, and the two
	# exclude each other, so their order does not matter: Caddy sorts same-name directives and puts one
	# without a matcher last, and a `route { }` block would run after routes.caddy's handle blocks.
	# Cloudflare sets CF-Connecting-IP to the real visitor and overwrites any value the visitor
	# sent: through the tunnel, that is the client.
	@viaCloudflare header Cf-Connecting-Ip *
	vars @viaCloudflare client_ip {header.Cf-Connecting-Ip}
	# Someone on this machine (curl to the published port): Caddy's own view of the client.
	@notViaCloudflare not header Cf-Connecting-Ip *
	vars @notViaCloudflare client_ip {remote_host}

	import /etc/caddy/routes.caddy
}
